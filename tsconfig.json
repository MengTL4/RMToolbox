{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": [
    "app/gui/src/**/*.ts",
    "app/gui/src/**/*.vue",
    "app/gui/src/**/*.d.ts"
  ]
}
